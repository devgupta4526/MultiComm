<!DOCTYPE html>
<html lang="en">
<head>
    <title>Eshop Seller Activation Email</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style type="text/css">
        /* Base */
        body {
            margin: 0;
            padding: 0;
            min-width: 100%;
            font-family: Arial, sans-serif;
            font-size: 16px;
            line-height: 1.5;
            background-color: #fafafa;
            color: #222222;
        }

        a {
            color: #1a73e8;
            text-decoration: none;
        }

        h1 {
            font-size: 24px;
            font-weight: 700;
            line-height: 1.25;
            margin: 0 0 15px 0;
            text-align: center;
        }

        p {
            margin-top: 0;
            margin-bottom: 24px;
        }

        table {
            border-collapse: collapse !important;
        }

        table td {
            vertical-align: top;
        }

        /* Layout */
        .email-wrapper {
            max-width: 600px;
            margin: 0 auto;
        }

        .email-container {
            width: 100%;
            background-color: #ffffff;
            border: 1px solid #e6e6e6;
            border-radius: 8px;
            overflow: hidden;
        }

        .email-header {
            padding: 18px 24px;
            background: #0f172a;
            color: #ffffff;
            text-align: center;
        }

        .brand {
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.3px;
        }

        .email-body {
            padding: 24px;
        }

        .otp {
            display: inline-block;
            letter-spacing: 4px;
            font-size: 28px;
            font-weight: 700;
            color: #0f172a;
            background: #f3f4f6;
            padding: 12px 16px;
            border-radius: 6px;
            border: 1px solid #e5e7eb;
            margin: 8px 0 16px 0;
        }

        .cta {
            display: inline-block;
            background: #1a73e8;
            color: #ffffff !important;
            padding: 12px 18px;
            border-radius: 6px;
            font-weight: 600;
        }

        .email-footer {
            text-align: center;
            color: #6b7280;
            font-size: 12px;
            padding: 16px 24px;
        }

        /* Mobile tweaks */
        @media only screen and (max-width: 620px) {
            .email-body {
                padding: 18px;
            }

            h1 {
                font-size: 22px;
            }

            .otp {
                font-size: 24px;
                letter-spacing: 3px;
            }
        }
    </style>
</head>

<body>
    <center class="email-wrapper">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
            <tr>
                <td align="center">
                    <table role="presentation" class="email-container" width="100%" cellpadding="0" cellspacing="0">

                        <!-- Header -->
                        <tr>
                            <td class="email-header">
                                <div class="brand">Eshop</div>
                            </td>
                        </tr>

                        <!-- Body -->
                        <tr>
                            <td class="email-body">
                                <h1>Activate your Eshop Seller Account</h1>

                                <p>Hello <%= name %>,</p>

                                <p>
                                    Welcome to Eshop as a seller! To activate your seller account and start listing your products, please use the following activation code:
                                </p>

                                <div class="otp">
                                    <%= otp %>
                                </div>

                                <p>
                                    Enter this code on the seller activation page within the next 5 minutes to complete your registration.
                                </p>

                                <% if (typeof activationUrl !=='undefined' && activationUrl) { %>
                                    <p style="text-align:center; margin: 24px 0 12px;">
                                        <a href="<%= activationUrl %>" class="cta">Open Seller Activation Page</a>
                                    </p>
                                <% } %>

                                <p>
                                    If you did not apply to become a seller on Eshop, please ignore this email.
                                </p>

                                <p style="margin-bottom: 0;">
                                    Thank you for joining us,<br />
                                    The Eshop Team
                                </p>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td class="email-footer">
                                © <%= new Date().getFullYear() %> Eshop. All rights reserved.
                            </td>
                        </tr>

                    </table>
                </td>
            </tr>
        </table>
    </center>
</body>

</html>
